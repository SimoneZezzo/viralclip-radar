[Unit]
Description=Read-only ViralClip Radar operations health

[Service]
Type=oneshot
User=viralclip
Group=viralclip
WorkingDirectory=/opt/viralclip-ops
Environment=PYTHON_DOTENV_DISABLED=1
LoadCredential=alert-url:/etc/viralclip/ops/alert-url
ExecStartPre=/opt/viralclip-ops/.venv/bin/python -B -m viralclip.operations probe --database /var/lib/viralclip-radar/viralclip.sqlite3 --backup-dir /var/lib/viralclip-radar/backups
ExecStart=/opt/viralclip-ops/.venv/bin/python -B -m viralclip.operations monitor --database /var/lib/viralclip-radar/viralclip.sqlite3 --backup-dir /var/lib/viralclip-radar/backups
TimeoutStartSec=60s
Nice=10
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
