# Install as /etc/viralclip/collector.env, owner root:root, mode 0600.
# Supply the existing credentials only on the authorized Linux host.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
VIRALCLIP_DB_PATH=/var/lib/viralclip-radar/viralclip.sqlite3
VIRALCLIP_HTTP_LOG_DIR=/var/lib/viralclip-radar
VIRALCLIP_GAME_IDS=
DISCOVERY_INTERVAL_SECONDS=300
DISCOVERY_LOOKBACK_MINUTES=30
