[Unit]
Description=ViralClip Radar GTA VI launch collector
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/viralclip/gta-vi-authorized
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=viralclip-gta-vi
Group=viralclip-gta-vi
WorkingDirectory=/opt/viralclip-gta-vi
StateDirectory=viralclip-gta-vi
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/viralclip/gta-vi.env
Environment=PYTHON_DOTENV_DISABLED=1
ExecStart=/opt/viralclip-gta-vi/.venv/bin/python -Bu -m viralclip.gta_vi run
Restart=on-failure
RestartSec=30s
KillSignal=SIGINT
TimeoutStopSec=120s
StandardOutput=journal
StandardError=journal
Nice=10
CPUQuota=35%
IOWeight=20
MemoryHigh=256M
MemoryMax=512M
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
