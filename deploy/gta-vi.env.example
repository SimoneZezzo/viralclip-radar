# Install separately as /etc/viralclip/gta-vi.env (root:root 0600).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
VIRALCLIP_GTA_VI_GAME_ID=1867279146
VIRALCLIP_GAMES=
VIRALCLIP_GAME_IDS=
VIRALCLIP_DB_PATH=/var/lib/viralclip-gta-vi/gta-vi.sqlite3
VIRALCLIP_HTTP_LOG_DIR=/var/lib/viralclip-gta-vi
DISCOVERY_INTERVAL_SECONDS=300
DISCOVERY_LOOKBACK_MINUTES=10
# Keep the reviewed default. Increasing this applies only to the preceding bucket.
VIRALCLIP_GTA_VI_OVERLAP_PAGES=7
VIRALCLIP_GTA_VI_EXTRA_PAGE_SECONDS=15
