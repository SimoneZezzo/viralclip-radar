# Install as /etc/viralclip/game-<ID>.env, owner root:root, mode 0600.
# One Twitch application per catalog collector: Helix rate limits follow the client ID.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
VIRALCLIP_DB_PATH=/var/lib/viralclip-game-<ID>/game.sqlite3
VIRALCLIP_HTTP_LOG_DIR=/var/lib/viralclip-game-<ID>
VIRALCLIP_GAMES=
VIRALCLIP_GAME_IDS=<ID>
DISCOVERY_INTERVAL_SECONDS=300
DISCOVERY_LOOKBACK_MINUTES=30
