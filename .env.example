# Create an application at https://dev.twitch.tv/console/apps and use its
# Client ID and Client Secret. Never commit your real .env file.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional. Defaults to data/viralclip.sqlite3 in the project directory.
VIRALCLIP_DB_PATH=data/viralclip.sqlite3

# Optional. Defaults to the database directory. Set to off to disable HTTP JSONL logs.
# VIRALCLIP_HTTP_LOG_DIR=data/logs

# Games may be names (resolved via Twitch) or configure category IDs separately.
VIRALCLIP_GAMES=Grand Theft Auto V
VIRALCLIP_GAME_IDS=

# Discovery runs about every 5 minutes and overlaps the recent 30-minute window.
DISCOVERY_INTERVAL_SECONDS=300
DISCOVERY_LOOKBACK_MINUTES=30
